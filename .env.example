# Copy to .env. NOT required for `make eval` or `make smoke` -- both run offline
# against the committed cache. Needed only for `make labels` and for a cache miss
# on `make eval-full`.
# Generator, LLM baseline, taxonomy naming, playbook distiller.
OPENAI_API_KEY=
# Judge. A different model family from the generator, by design (docs/04 §5).
GEMINI_API_KEY=
# Optional: the original Claude generator / judge fallback.
ANTHROPIC_API_KEY=
# Optional: open-weight judge/distiller via vLLM (DGX experiment path).
VLLM_BASE_URL=http://localhost:8000/v1
